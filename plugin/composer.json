{
	"name": "launch-up/launchup-sales-connector",
	"description": "Launch Up Sales Connector — pushes monthly WooCommerce sales aggregates to Launch Hub.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload-dev": {
		"psr-4": {
			"LaunchUp\\SalesConnector\\": "includes/",
			"LaunchUp\\SalesConnector\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit --testsuite unit",
		"test:all": "phpunit",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
